# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# celo-sepolia (testnet stand-ins) or celo (mainnet). Stand-ins are never used on celo.
NEXT_PUBLIC_NETWORK=celo-sepolia

# Public (sent to the browser)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never prefix with NEXT_PUBLIC_)
PRIVY_APP_SECRET=
SUPABASE_SECRET_KEY=

# Email alerts via Resend (optional; off unless all three are set). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Rest My Case <alerts@your-domain>"
# Any long random string, e.g. `openssl rand -base64 32`. Signs the unsubscribe links; changing it breaks old links.
EMAIL_UNSUBSCRIBE_SECRET=
# Public URL of the app, used in email/Telegram/push links.
APP_URL=
